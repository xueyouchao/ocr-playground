# build inputs/outputs that can be regenerated
__pycache__/
*.py[cod]
.venv/
.venv-index/
/tmp/
.pytest_cache/
.ruff_cache/

# the indexer's declared output and CocoIndex's memo database
/out/
/cocoindex.db

# the page renders are rebuilt by scripts/prepare.py; the previews are small enough to keep

# scratch screenshots of the page, not artefacts of the build
.find-*.png

# the codebase indexer's local overrides (tooling, not the repo's contract)
.cbmignore
